# Frontend (Vite). Values come from the Supabase project's API settings.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Contact address shown in the privacy policy and terms (/privacy, /terms).
VITE_SUPPORT_EMAIL=
# "true" shows Google sign-in; needs the Google provider in Supabase Auth (docs/deploy.md).
VITE_GOOGLE_AUTH=
# Web push public key for study reminders (docs/reminders.md).
VITE_VAPID_PUBLIC_KEY=
# Toss Payments client key for the Pro pass (docs/monetization.md). Empty = fake-door checkout.
VITE_TOSS_CLIENT_KEY=

# Edge function secrets (set in Supabase, not in this file):
#   GEMINI_API_KEY             Gemini API key (aistudio.google.com)
#   SUPABASE_SERVICE_ROLE_KEY  quota, usage log, storage, account deletion, reminders
#   AI_MODEL_DEFAULT           optional Gemini model override (default gemini-2.5-flash)
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT  web push (docs/reminders.md)
#   REMINDER_CRON_SECRET       shared secret the reminder cron job sends
#   TOSS_SECRET_KEY            Toss Payments secret key, confirms Pro payments (docs/monetization.md)
