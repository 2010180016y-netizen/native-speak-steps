# Frontend (Vite). Values come from the Neon console: Auth and Data API pages.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
# "true" shows Google sign-in once the Google provider is set up in Neon Auth.
VITE_GOOGLE_AUTH=
# Contact address shown in the privacy policy and terms (/privacy, /terms).
VITE_SUPPORT_EMAIL=
# Web push public key for study reminders (docs/reminders.md).
VITE_VAPID_PUBLIC_KEY=
# Toss Payments client key for the Pro pass (docs/monetization.md). Empty = fake-door checkout.
VITE_TOSS_CLIENT_KEY=

# Server functions in api/ (set in Vercel, never in this file):
#   DATABASE_URL               Neon connection string (owner role; server functions only)
#   NEON_AUTH_JWKS_URL         Neon Auth JWKS URL, verifies the session tokens the app sends
#   GEMINI_API_KEY             Gemini API key (aistudio.google.com)
#   AI_MODEL_DEFAULT           optional model override
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT  web push (docs/reminders.md)
#   REMINDER_CRON_SECRET       shared secret the hourly reminder workflow sends
#   TOSS_SECRET_KEY            Toss Payments secret key, confirms Pro payments (docs/monetization.md)
